# Meenakshi Girish — environment variables
# Copy the relevant values into Vercel (Project → Settings → Environment Variables).
# NEVER commit a real .env. (.env is gitignored.)

# ── CMS admin auth ───────────────────────────────────────────────────────────
# Admin login username (you choose; high-entropy, not guessable).
ADMIN_USERNAME=

# PBKDF2 hash of the admin password. Generate locally with:
#   node scripts/hash-password.mjs
# Paste the printed `pbkdf2$<iter>$<salt>$<hash>` string here. The plaintext
# password is stored NOWHERE — not in code, not in git, not in env.
ADMIN_PASSWORD_HASH=

# HMAC key for signing the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be ≥ 32 chars; the auth layer fails CLOSED (no login, no sessions)
# if this is missing or too short.
SESSION_SECRET=

# ── CMS content backend (GitHub) ─────────────────────────────────────────────
# Fine-grained PAT scoped to ONLY aacharles111/MeenakshiGirish,
# permissions: Contents: Read & Write + Metadata: Read.
# GitHub → Settings → Developer settings → Personal access tokens → Fine-grained.
GITHUB_TOKEN=

GITHUB_REPO=aacharles111/MeenakshiGirish
GITHUB_BRANCH=master

# ── Optional: deploy-status in the admin UI ──────────────────────────────────
# If set, the admin dashboard polls the latest production deployment after a
# save and shows Building → Live. Scope: project:read.
# Find the IDs in your local .vercel/project.json (or the Vercel dashboard).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

# ── Order + contact email (already configured earlier) ───────────────────────
RESEND_API_KEY=
ORDER_FROM_EMAIL=Meenakshi Girish <orders@meenakshigirish.com>
ORDER_NOTIFY_EMAIL=meenakshigirish31@gmail.com
GOOGLE_SHEET_URL=
SHEET_SECRET=

# ── Razorpay (live keys) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
